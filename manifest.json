{
    "manifest_version": 2.0,
    "id": "bghostcomp",
    "name": "Hosts | Components",
    "version": "1.2.2",
    "namespace": "BGmotHostsComponents",
    "author": "Encore Technologies (fork of Evgeny Yurchenko / BGmot)",
    "url": "https://github.com/BGmot/zabbix-module-hosts-tree",
    "description": "Hosts tree with expandable per-host component view (CPU/memory/storage/network grouped from items). Fork of BGmot/zabbix-module-hosts-tree. Adds menu item Monitoring -> Hosts | Components.",
    "actions": {
        "bghostcomp.view": {
            "class": "CControllerBGHostView",
            "view": "module.monitoring.bghost.view"
        },
        "bghostcomp.view.refresh": {
            "class": "CControllerBGHostViewRefresh",
            "view": "module.monitoring.bghost.view.refresh",
            "layout": "layout.json"
        },
        "bghostcomp.component.view": {
            "class": "CControllerBGHostComponentView",
            "view": "module.monitoring.bghost.component.view",
            "layout": "layout.json"
        },
        "bghostcomp.component.sparkline": {
            "class": "CControllerBGHostComponentSparkline",
            "layout": "layout.json"
        }
    }
}
